{
  "name": "una-chat-lab5",
  "version": "1.0.0",
  "description": "Chat seguro para Lab 5 de Seguridad Informática - Universidad Nacional Costa Rica",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci",
    "demo": "node demo/xss-test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:report": "eslint . --ext .js --format json --output-file eslint-report.json",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "npm run lint && npm run test:coverage && npm run security:audit",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ci": "npm run lint && npm run test:ci && npm run security:audit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.20.0",
    "express-openid-connect": "^2.19.3",
    "express-session": "^1.18.2",
    "socket.io": "^4.8.1",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4"
  },
  "keywords": [
    "una",
    "chat",
    "socket.io",
    "seguridad",
    "xss",
    "validacion",
    "lab5"
  ],
  "author": "Roberth Cascante- Ingeniería en Sistemas",
  "license": "MIT",
  "university": "Universidad Nacional de Costa Rica",
  "campus": "Sede Regional Chorotega - Campus Nicoya",
  "course": "Seguridad Informática",
  "lab": "Lab 5",
  "professor": "Ing. Alex Villegas Carranza, M.Sc."
}
