{
  "env": { "node": true, "es2021": true, "jest": true },
  "extends": ["eslint:recommended", "plugin:security/recommended"],
  "plugins": ["security"],
  "rules": {
    "no-unused-vars": "warn",
    "no-eval": "error",
    "security/detect-object-injection": "error",
    "no-console": "warn"
  }
}
